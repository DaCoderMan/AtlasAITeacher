DATABASE_URL=
ATLAS_USER_ID=default

# Required for HTTP ingestion endpoints. Use long random secrets.
ATLAS_INGEST_SECRET=
ATLAS_WORKER_SECRET=

# Remote MCP for ChatGPT/OpenAI. Keep unauthenticated=false for public hosting.
ATLAS_MCP_SECRET=
ATLAS_MCP_ALLOW_UNAUTHENTICATED=false

# Optional automatic destination webhooks. Atlas sends normalized routing payloads here.
ATLAS_ROUTE_SECRET=
ATLAS_ROUTE_NOTION_URL=
ATLAS_ROUTE_DRIVE_URL=
ATLAS_ROUTE_GITHUB_URL=
ATLAS_ROUTE_CALENDAR_URL=
ATLAS_ROUTE_MEMORY_URL=

# Local daemon settings.
ATLAS_DAEMON_INTERVAL_MS=5000
ATLAS_DAEMON_BATCH_SIZE=25

# Automatic local file inbox. Drop exports/files here for ingestion.
ATLAS_DROPBOX_DIR=./atlas-inbox
ATLAS_DROPBOX_INTERVAL_MS=10000
ATLAS_DROPBOX_MAX_TEXT_BYTES=1048576

NOTION_TOKEN=
PROJECT_X_NOTION_PAGE_ID=3bbf67e61d9d81838205c6e20f9bb037
PROJECT_X_SYNC_SECRET=
NOTION_VERSION=2022-06-28
