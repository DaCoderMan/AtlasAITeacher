DATABASE_URL=
ATLAS_USER_ID=default

# Required for HTTP ingestion endpoints. Use long random secrets.
ATLAS_INGEST_SECRET=
ATLAS_WORKER_SECRET=

# Remote MCP. Keep unauthenticated=false for public hosting.
ATLAS_MCP_SECRET=
ATLAS_MCP_ALLOW_UNAUTHENTICATED=false

# OAuth resource-server configuration for ChatGPT remote MCP.
# Issuer must expose OAuth/OIDC discovery and issue RS256 JWT access tokens.
ATLAS_MCP_OAUTH_ISSUER=
ATLAS_MCP_OAUTH_AUDIENCE=
ATLAS_MCP_OAUTH_JWKS_URL=
ATLAS_MCP_OAUTH_AUTHORIZATION_SERVER=
ATLAS_MCP_RESOURCE_URL=
ATLAS_MCP_RESOURCE_METADATA_URL=
ATLAS_MCP_OAUTH_READ_SCOPE=atlas.read
ATLAS_MCP_OAUTH_WRITE_SCOPE=atlas.write

# Authenticated dashboard API. Falls back to ATLAS_MCP_SECRET if empty.
ATLAS_DASHBOARD_SECRET=

# Automatic destination webhooks. Atlas sends normalized routing payloads here.
ATLAS_ROUTE_SECRET=
ATLAS_ROUTE_TIMEOUT_MS=10000
ATLAS_ROUTE_NOTION_URL=
ATLAS_ROUTE_DRIVE_URL=
ATLAS_ROUTE_GITHUB_URL=
ATLAS_ROUTE_CALENDAR_URL=
ATLAS_ROUTE_GMAIL_URL=
ATLAS_ROUTE_MEMORY_URL=

# Optional live health probes. Configuration alone never counts as healthy.
ATLAS_HEALTH_SECRET=
ATLAS_HEALTH_NOTION_URL=
ATLAS_HEALTH_DRIVE_URL=
ATLAS_HEALTH_GITHUB_URL=
ATLAS_HEALTH_CALENDAR_URL=
ATLAS_HEALTH_GMAIL_URL=
ATLAS_HEALTH_MEMORY_URL=
ATLAS_HEALTH_VOICE_URL=

# Queue and local daemon settings.
ATLAS_QUEUE_MAX_ATTEMPTS=5
ATLAS_DAEMON_INTERVAL_MS=5000
ATLAS_DAEMON_BATCH_SIZE=25

# Automatic local file inbox. Drop exports/files here for ingestion.
ATLAS_DROPBOX_DIR=./atlas-inbox
ATLAS_DROPBOX_INTERVAL_MS=10000
ATLAS_DROPBOX_MAX_TEXT_BYTES=1048576

# Existing Project X Notion mirror.
NOTION_TOKEN=
PROJECT_X_NOTION_PAGE_ID=3bbf67e61d9d81838205c6e20f9bb037
PROJECT_X_SYNC_SECRET=
NOTION_VERSION=2022-06-28
